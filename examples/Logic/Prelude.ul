# The logical connectives, as ordinary axioms. The core only knows "=>".
# These are constructive: excluded middle is deliberately absent (see Classical.ul).

# and
pair : \A B. A => B => and A B;
fst : \A B. and A B => A;
snd : \A B. and A B => B;

# or
left : \A B. A => or A B;
right : \B A. B => or A B;
case : \A B C. or A B => (A => C) => (B => C) => C;

# false, and "not P" written as P => false
explode : \C. false => C;

# Some consequences
and_comm = \P. pair (snd P) (fst P);
or_comm = \P. case P right left;
contradiction : \A B. A => (A => false) => B = \P Np. explode (Np P);
tollens : \P Q. (P => Q) => (Q => false) => P => false = \F Nq P. Nq (F P);
