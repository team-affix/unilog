# Classical logic is one belief away: excluded middle, stated as an axiom.
# Anything proved with it lists Logic.Classical.lem among its axioms (`unilog axioms`).
import Logic.Prelude;

lem : \P. or P (P => false);

double_negation : \P. ((P => false) => false) => P =
    \Nnp. case lem (\P. P) (\Np. explode (Nnp Np));
