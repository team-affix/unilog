{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Unilog",
    "scopeName": "source.unilog",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#import"
        },
        {
            "include": "#declaration"
        },
        {
            "include": "#proof"
        },
        {
            "include": "#proposition"
        }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.unilog",
            "match": "#.*$"
        },
        "import": {
            "match": "^\\s*(import)\\s+([A-Za-z0-9_']+(?:\\.[A-Za-z0-9_']+)*)",
            "captures": {
                "1": {
                    "name": "keyword.control.import.unilog"
                },
                "2": {
                    "name": "entity.name.namespace.unilog"
                }
            }
        },
        "declaration": {
            "comment": "A declaration's name: at the start of a line, followed by ':' or '=' (but not '=>').",
            "match": "^\\s*([a-z0-9][A-Za-z0-9_']*)\\s*(?=:|=(?!>))",
            "captures": {
                "1": {
                    "name": "entity.name.function.unilog"
                }
            }
        },
        "proof": {
            "comment": "A declaration's proof: from its '=' (not '=>') up to the ';' that ends the declaration, possibly over several lines. Uppercase names here are assumptions.",
            "begin": "(?<![=!<>:])=(?![=>])",
            "beginCaptures": {
                "0": {
                    "name": "keyword.operator.equals.unilog"
                }
            },
            "end": "(?=;)",
            "name": "meta.proof.unilog",
            "patterns": [
                {
                    "include": "#proofBody"
                }
            ]
        },
        "proposition": {
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "name": "keyword.operator.arrow.unilog",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.colon.unilog",
                    "match": ":"
                },
                {
                    "comment": "A quantifier: a symbol whose argument is a lambda, e.g. exists in `exists \\X. ...` (or `exists (\\X. ...)`).",
                    "match": "\\b([a-z0-9][A-Za-z0-9_']*)(?=\\s*\\(?\\s*\\\\)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.quantifier.unilog"
                        }
                    }
                },
                {
                    "comment": "A lambda's head in a proposition, `\\X Y.`: where a proposition is expected it means 'for every X and Y'.",
                    "match": "(\\\\)\\s*((?:[A-Za-z0-9_']+\\s*)+?)\\s*(\\.)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.quantifier.unilog"
                        },
                        "2": {
                            "name": "entity.name.type.parameter.unilog"
                        },
                        "3": {
                            "name": "keyword.other.quantifier.unilog"
                        }
                    }
                },
                {
                    "comment": "Variables in propositions (under Curry-Howard, propositions are types, so these are type parameters)",
                    "name": "entity.name.type.parameter.unilog",
                    "match": "\\b[A-Z_][A-Za-z0-9_']*"
                },
                {
                    "comment": "Atoms: the symbols propositions are about (likes, jake, cake). Lowercase or digit first.",
                    "name": "constant.other.symbol.unilog",
                    "match": "\\b[a-z0-9][A-Za-z0-9_']*"
                },
                {
                    "name": "punctuation.terminator.unilog",
                    "match": ";"
                },
                {
                    "include": "#parens"
                }
            ],
            "comment": "Also used for whole lines outside proofs, so it colors the ';' that ends a declaration."
        },
        "qualified": {
            "comment": "A qualified reference, e.g. Kant.Ethics.duty",
            "match": "\\b((?:[A-Za-z0-9_']+\\.)+)([A-Za-z0-9_']+)",
            "captures": {
                "1": {
                    "name": "entity.name.namespace.unilog"
                },
                "2": {
                    "name": "variable.other.unilog"
                }
            }
        },
        "parens": {
            "name": "punctuation.parenthesis.unilog",
            "match": "[()]"
        },
        "proofBody": {
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "comment": "An assumption's head, \\F G X. : the names are assumptions, introduced for the body after the '.'",
                    "begin": "\\\\",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.operator.lambda.unilog"
                        }
                    },
                    "end": "\\.",
                    "endCaptures": {
                        "0": {
                            "name": "keyword.operator.lambda.unilog"
                        }
                    },
                    "name": "meta.assumption.head.unilog",
                    "patterns": [
                        {
                            "include": "#comment"
                        },
                        {
                            "name": "variable.parameter.assumption.unilog",
                            "match": "[A-Za-z0-9_']+"
                        }
                    ]
                },
                {
                    "comment": "A qualified reference to a proof, e.g. Kant.Ethics.duty",
                    "match": "\\b((?:[A-Za-z0-9_']+\\.)+)([a-z0-9][A-Za-z0-9_']*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.unilog"
                        },
                        "2": {
                            "name": "entity.name.function.proof.unilog"
                        }
                    }
                },
                {
                    "comment": "Assumptions: variables standing for proofs",
                    "name": "variable.parameter.assumption.unilog",
                    "match": "\\b[A-Z_][A-Za-z0-9_']*"
                },
                {
                    "comment": "Lowercase names in a proof refer to axioms and inferences: proofs",
                    "name": "entity.name.function.proof.unilog",
                    "match": "\\b[a-z0-9][A-Za-z0-9_']*"
                },
                {
                    "include": "#parens"
                }
            ]
        }
    }
}
