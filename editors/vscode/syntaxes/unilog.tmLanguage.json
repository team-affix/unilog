{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Unilog",
    "scopeName": "source.unilog",
    "patterns": [
        { "include": "#comment" },
        { "include": "#import" },
        { "include": "#declaration" },
        { "include": "#proof" },
        { "include": "#proposition" }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.unilog",
            "match": "#.*$"
        },
        "import": {
            "match": "^\\s*(import)\\s+([A-Za-z0-9_']+(?:\\.[A-Za-z0-9_']+)*)",
            "captures": {
                "1": { "name": "keyword.control.import.unilog" },
                "2": { "name": "entity.name.namespace.unilog" }
            }
        },
        "declaration": {
            "comment": "A declaration's name: at the start of a line, followed by ':' or '=' (but not '=>').",
            "match": "^\\s*([a-z0-9][A-Za-z0-9_']*)\\s*(?=:|=(?!>))",
            "captures": {
                "1": { "name": "entity.name.function.unilog" }
            }
        },
        "proof": {
            "comment": "A declaration's proof: from its '=' (not '=>') up to the '.' that ends the declaration, possibly over several lines. Uppercase names here are assumptions.",
            "begin": "(?<![=!<>:])=(?![=>])",
            "beginCaptures": { "0": { "name": "keyword.operator.equals.unilog" } },
            "end": "(?=\\.(?![A-Za-z0-9_']))",
            "name": "meta.proof.unilog",
            "patterns": [
                { "include": "#comment" },
                { "name": "keyword.operator.arrow.unilog", "match": "=>" },
                { "include": "#qualified" },
                {
                    "comment": "Assumptions: variables standing for proofs",
                    "name": "variable.parameter.assumption.unilog",
                    "match": "\\b[A-Z_][A-Za-z0-9_']*"
                },
                { "include": "#parens" }
            ]
        },
        "proposition": {
            "patterns": [
                { "include": "#comment" },
                { "name": "keyword.operator.arrow.unilog", "match": "=>" },
                { "name": "keyword.operator.colon.unilog", "match": ":" },
                {
                    "comment": "Variables in propositions (under Curry-Howard, propositions are types, so these are type parameters)",
                    "name": "entity.name.type.parameter.unilog",
                    "match": "\\b[A-Z_][A-Za-z0-9_']*"
                },
                { "name": "punctuation.terminator.unilog", "match": "\\.(?![A-Za-z0-9_'])" },
                { "include": "#parens" }
            ]
        },
        "qualified": {
            "comment": "A qualified reference, e.g. Kant.Ethics.duty",
            "match": "\\b((?:[A-Za-z0-9_']+\\.)+)([A-Za-z0-9_']+)",
            "captures": {
                "1": { "name": "entity.name.namespace.unilog" },
                "2": { "name": "variable.other.unilog" }
            }
        },
        "parens": {
            "name": "punctuation.parenthesis.unilog",
            "match": "[()]"
        }
    }
}
